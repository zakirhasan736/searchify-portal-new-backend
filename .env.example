DATABASE_URL=postgresql+psycopg://searchify:searchify@127.0.0.1:55432/searchify
JWT_SECRET=change-this-local-secret
JWT_HOURS=12

# Switch these two lines when the site goes live.
PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PUBLIC_SITE_URL=https://app.example.com
# CORS_ORIGINS=https://app.example.com

# OpenAI — workspace secret only (never NEXT_PUBLIC_*)
OPENAI_API_KEY=
OPENAI_MODEL_ASTRA=gpt-6-astra
OPENAI_MODEL_DEFAULT=gpt-6-astra
OPENAI_MODEL_WRITER=gpt-6-astra
OPENAI_MODEL_ANALYST=gpt-6-astra
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_VISION=gpt-4o

# Google (optional until Connect UX ships)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/oauth/google/callback
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v19

# Local seed accounts created on first startup.
# client / Client#1234
# admin / Admin#1234
