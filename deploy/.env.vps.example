# Production URLs for Searchify on VPS.
# Copy these into /var/www/searchify/backend/.env (keep secrets from your existing .env).

PUBLIC_SITE_URL=https://searchify.nextcreavo.com
CORS_ORIGINS=https://searchify.nextcreavo.com

GOOGLE_OAUTH_REDIRECT_URI=https://searchify-api.nextcreavo.com/api/v1/oauth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=https://searchify-api.nextcreavo.com/api/v1/auth/oauth/google/callback
GITHUB_OAUTH_REDIRECT_URI=https://searchify-api.nextcreavo.com/api/v1/auth/oauth/github/callback
